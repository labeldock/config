# Claude Code aliases — model tier × permission mode.
#
# onboard 의 source 방식은 이 파일을 ~/.bashrc 와 ~/.zshrc 양쪽에서 source 한다.
# bash / zsh 모두에서 동작한다.
#
# 명명 규칙:
#   1글자 c… 단독 세션 / t… teammate 세션 (tmux 안이면 tmux, 아니면 in-process)
#   2글자 p… opusplan / o… opus / f… fable / s… sonnet
#   꼬리  asp… --permission-mode auto / dsp… --dangerously-skip-permissions
#
# 컨텍스트: 이 별칭들(sonnet·opus·fable·opusplan)은 그대로 1M 이라 [1m] 을 붙이지 않는다.
# 붙여야 하는 건 «버전을 특정해서 핀할 때» 다 — claude-opus-4-6 은 200K, claude-opus-4-6[1m]
# 은 1M. 그리고 zsh 에서 [1m] 은 글롭이라 반드시 따옴표로 감싸야 한다.
#
# PowerShell 로 옮길 때는 --teammate-mode 줄을 쓰지 말 것 — Windows 에는 tmux 가 없다.

# claude plan (opusplan — plan with opus, execute with sonnet)
alias cpasp='CLAUDE_CODE_NO_FLICKER=1 claude --model opusplan --permission-mode auto'
alias cpdsp='CLAUDE_CODE_NO_FLICKER=1 claude --model opusplan --dangerously-skip-permissions'
alias tpasp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model opusplan --permission-mode auto'
alias tpdsp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model opusplan --dangerously-skip-permissions'

# claude opus edge (latest opus — coding cohesion)
alias coasp='CLAUDE_CODE_NO_FLICKER=1 claude --model opus --permission-mode auto'
alias codsp='CLAUDE_CODE_NO_FLICKER=1 claude --model opus --dangerously-skip-permissions'
alias toasp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model opus --permission-mode auto'
alias todsp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model opus --dangerously-skip-permissions'

# claude fable edge (fable — frontier)
alias cfasp='CLAUDE_CODE_NO_FLICKER=1 claude --model fable --permission-mode auto'
alias cfdsp='CLAUDE_CODE_NO_FLICKER=1 claude --model fable --dangerously-skip-permissions'
alias tfasp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model fable --permission-mode auto'
alias tfdsp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model fable --dangerously-skip-permissions'

# claude explorer or executor (sonnet — well-versed work)
alias csasp='CLAUDE_CODE_NO_FLICKER=1 claude --model sonnet --permission-mode auto'
alias csdsp='CLAUDE_CODE_NO_FLICKER=1 claude --model sonnet --dangerously-skip-permissions'
alias tsasp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model sonnet --permission-mode auto'
alias tsdsp='CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 CLAUDE_CODE_NO_FLICKER=1 claude --teammate-mode $([ -n "$TMUX" ] && echo tmux || echo in-process) --model sonnet --dangerously-skip-permissions'

# ── clipboard ────────────────────────────────────────────────────────────────
# Claude Code 의 복사 경로: 로컬이면 pbcopy / wl-copy·xclip·xsel / Set-Clipboard,
# SSH 면 OSC 52, tmux 안이면 tmux 버퍼에도 쓴다. SSH 여부는 SSH_CONNECTION 등으로 판단한다.
#
# tmux pane 의 셸은 처음 만들어질 때의 환경을 그대로 들고 있다. 로컬에서 만든 세션에
# 나중에 SSH 로 attach 하면(또는 반대로) 변수가 낡아서 Claude Code 가 경로를 잘못 고른다.
# 그래서 claude 를 띄우기 직전에 tmux 세션의 최신 값(.tmux.conf 의 update-environment)을
# 가져온다. 이미 떠 있는 claude 는 못 고치니, 머신을 바꿔 attach 했으면 claude 를 다시 띄울 것.
_claude_sync_tmux_env() {
  [ -n "$TMUX" ] || return 0
  local line
  while IFS= read -r line; do
    case $line in
      -*) unset "${line#-}" ;;
      *=*) export "$line" ;;
    esac
  done <<EOF_TMUX_ENV
$(tmux show-environment 2>/dev/null | grep -E '^-?(SSH_CONNECTION|SSH_CLIENT|SSH_TTY|DISPLAY|WAYLAND_DISPLAY|XAUTHORITY)(=|$)')
EOF_TMUX_ENV
}

claude() {
  _claude_sync_tmux_env
  command claude "$@"
}

# clipcheck — 지금 이 자리에서 클립보드가 어느 경로로 가는지 보여주고,
# OSC 52 로 테스트 문자열을 보낸다. 실행 후 아무 데나 붙여넣어 확인.
clipcheck() {
  local text b64 tool
  _claude_sync_tmux_env

  if [ -n "$SSH_CONNECTION$SSH_CLIENT$SSH_TTY" ]; then
    printf 'session  : SSH  → Claude Code 는 OSC 52 로 복사\n'
  else
    for tool in pbcopy wl-copy xclip xsel powershell.exe; do
      command -v "$tool" >/dev/null 2>&1 && break
      tool=
    done
    printf 'session  : local → 네이티브 도구 %s\n' "${tool:-없음 (xclip/xsel/wl-copy 설치 필요)}"
  fi

  if [ -n "$TMUX" ]; then
    printf 'tmux     : set-clipboard=%s mouse=%s allow-passthrough=%s\n' \
      "$(tmux show -sv set-clipboard)" "$(tmux show -gv mouse)" "$(tmux show -gv allow-passthrough)"
    [ "$(tmux show -sv set-clipboard)" = on ] ||
      printf '           ⚠ set-clipboard 가 on 이 아니면 앱이 보낸 OSC 52 를 tmux 가 버린다\n'
  fi
  printf 'terminal : TERM_PROGRAM=%s TERM=%s\n' "${TERM_PROGRAM:-?}" "$TERM"

  text="clipcheck $(date +%H:%M:%S)"
  b64=$(printf '%s' "$text" | base64 | tr -d '\r\n')
  printf '\033]52;c;%s\a' "$b64" >/dev/tty
  printf 'sent     : "%s" (OSC 52) — 붙여넣어서 이 문자열이 나오면 OK\n' "$text"
}
