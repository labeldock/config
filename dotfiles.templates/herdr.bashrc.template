# herdr helpers — tmux.bashrc.template 의 tz* 와 같은 패턴의 hz* 헬퍼.
#
# onboard 의 source 방식은 이 파일을 ~/.bashrc 와 ~/.zshrc 양쪽에서 source 한다.
# bash / zsh 모두에서 동작한다.
#
# herdr 는 pane 프로세스에 HERDR_ENV=1 을 넣는다. hz* 는 tmux 안($TMUX)에서
# herdr 를 띄우지 않도록 막고, `--force` 를 붙이면 허용한다. herdr / tmux 를
# 직접 실행하는 것에는 관여하지 않는다.

# hz* 가 herdr 를 띄워도 되는지 확인한다. usage: _herdr_start_check CMD FORCE
_herdr_start_check() {
  if [ "${HERDR_ENV:-}" = 1 ]; then
    printf 'Already in herdr. Detach with ctrl+b q first.\n'
    return 1
  fi
  if [ -n "${TMUX:-}" ] && [ "$2" != 1 ]; then
    printf '%s: inside tmux — starting herdr here is blocked on purpose.\n' "$1" >&2
    printf 'Run `%s --force` to start it anyway.\n' "$1" >&2
    return 1
  fi
}

# herdr: create or attach a session named parent-current dir
hzn() (
  local force=0 arg cwd current parent name

  for arg in "$@"; do
    [ "$arg" = --force ] && force=1
  done
  _herdr_start_check hzn "$force" || return

  cwd=${PWD%/}
  current=${cwd##*/}
  parent=${cwd%/*}
  parent=${parent##*/}

  if [ -z "$cwd" ] || [ "$cwd" = / ]; then
    name=root
  elif [ -z "$parent" ] || [ "$parent" = "$current" ]; then
    name=$current
  else
    name=${parent}-${current}
  fi

  # herdr 세션 이름은 ASCII 영숫자와 . _ - 만, 최대 64 바이트까지 허용한다.
  name=$(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' | cut -c1-64)
  herdr --session "$name"
)

# herdr: launch or attach the default session
hzt() (
  local force=0 arg

  for arg in "$@"; do
    [ "$arg" = --force ] && force=1
  done
  _herdr_start_check hzt "$force" || return

  herdr --session default
)

# herdr: pick a session from the list and attach
# fzf 가 있으면 커서로 고르고, 없으면 번호를 입력받는다.
hza() (
  local force=0 arg list header rows count line choice name

  for arg in "$@"; do
    [ "$arg" = --force ] && force=1
  done
  _herdr_start_check hza "$force" || return

  # 첫 줄은 헤더, 들여쓴 줄은 바로 위 세션의 연결 오류 메시지다.
  list=$(herdr session list) || return
  header=$(printf '%s\n' "$list" | sed -n 1p)
  rows=$(printf '%s\n' "$list" | sed 1d | grep -v '^ ')

  if [ -z "$rows" ]; then
    printf 'No herdr sessions. Use hzt or hzn to start one.\n'
    return 1
  fi

  if command -v fzf >/dev/null 2>&1 && [ -t 0 ] && [ -t 1 ]; then
    line=$(printf '%s\n%s\n' "$header" "$rows" |
      fzf --header-lines=1 --reverse --height=40% --prompt='herdr session> ') || return
  else
    count=0
    printf '     %s\n' "$header"
    while IFS= read -r line; do
      count=$((count + 1))
      printf '%3d) %s\n' "$count" "$line"
    done <<EOF
$rows
EOF
    printf 'Select session [1-%d]: ' "$count"
    read -r choice || return
    case $choice in
      '' | *[!0-9]*) printf 'Invalid choice: %s\n' "$choice" >&2; return 1 ;;
    esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
      printf 'Invalid choice: %s\n' "$choice" >&2
      return 1
    fi
    line=$(printf '%s\n' "$rows" | sed -n "${choice}p")
  fi

  name=${line%% *}
  [ -n "$name" ] || return
  herdr --session "$name"
)

# herdr: list sessions (extra args such as --json are passed through)
hzl() {
  herdr session list "$@"
}
