# tmux helpers — attach with tmux's tree picker and an independent view.
#
# onboard 의 source 방식은 이 파일을 ~/.bashrc 와 ~/.zshrc 양쪽에서 source 한다.
# bash / zsh 모두에서 동작한다.
#
# tzn / tzt / tza 는 herdr 안(HERDR_ENV=1)에서 tmux 를 띄우지 않도록 막고,
# `--force` 를 붙이면 허용한다. 세션을 만들지 않고 목록만 보는 tzl 은 막지 않으며,
# tmux / herdr 를 직접 실행하는 것에도 관여하지 않는다.

# herdr pane 안이면 경고하고 막는다. usage: _tmux_herdr_check CMD FORCE
_tmux_herdr_check() {
  if [ "${HERDR_ENV:-}" = 1 ] && [ "$2" != 1 ]; then
    printf '%s: inside herdr — starting tmux here is blocked on purpose.\n' "$1" >&2
    printf 'Run `%s --force` to start it anyway.\n' "$1" >&2
    return 1
  fi
}

_tmux_tree_attach() (
  local scope=$1 session=$2 picker view watcher action filter

  picker="picker-$$-${RANDOM}"
  view="view-$$-${RANDOM}"
  picker=$(printf '%s' "$picker" | tr '.: ' '___')
  view=$(printf '%s' "$view" | tr '.: ' '___')

  watcher='
    seen=0
    tries=0
    while [ "$tries" -lt 200 ]; do
      state=$(tmux display-message -p -t "$TMUX_PANE" "#{session_attached}:#{pane_in_mode}" 2>/dev/null) || exit
      case $state in
        0:*) [ "$seen" -eq 1 ] && exit ;;
        *:1) seen=1; break ;;
        *:*) seen=1 ;;
      esac
      tries=$((tries + 1))
      sleep 0.05
    done
    [ "$tries" -lt 200 ] || exit
    while :; do
      state=$(tmux display-message -p -t "$TMUX_PANE" "#{session_attached}:#{pane_in_mode}" 2>/dev/null) || exit
      case $state in
        0:*) exit ;;
        *:0) break ;;
      esac
      sleep 0.05
    done
    tries=0
    while [ "$(tmux show-option -qv -t "'"$picker"'" @picker-selected)" = 1 ] &&
          [ "$tries" -lt 200 ]; do
      [ "$(tmux display-message -p -t "'"$picker"'" "#{session_attached}")" -eq 0 ] && exit
      tries=$((tries + 1))
      sleep 0.05
    done
    tmux detach-client -s "'"$picker"'" 2>/dev/null
  '

  action="set-option -t \"$picker\" @picker-selected 1 ; run-shell 'target=\"%%\"; client=\"#{client_name}\"; session=\$(tmux display-message -p -t \"\$target\" \"##{session_name}\"); window=\$(tmux display-message -p -t \"\$target\" \"##{window_index}\"); path=\$(tmux display-message -p -t \"\$target\" \"##{session_path}\"); if tmux new-session -d -s \"$view\" -t \"=\$session\" -c \"\$path\" &&tmux switch-client -c \"\$client\" -t \"$view:\$window\"; then tmux set-option -t \"$view\" destroy-unattached on; else tmux set-option -t \"$picker\" @picker-selected 0; tmux kill-session -t \"$view\" 2>/dev/null; fi'"

  if [ "$scope" = session ]; then
    filter="#{==:#{session_name},$session}"
  else
    filter="#{!=:#{session_name},$picker}"
  fi

  # view 세션은 -c 로 원본 세션의 session_path 를 물려받는다. 없으면 tzt/tza 를
  # 실행한 cwd 가 기본 디렉터리가 되어 split/new-window 가 엉뚱한 곳에서 열린다.
  tmux new-session -s "$picker" "$watcher" \
    \; choose-tree -Zw -f "$filter" "$action"
)

# tmux: create or attach a session named parent-current dir
tzn() (
  local force=0 arg cwd current parent name

  for arg in "$@"; do
    [ "$arg" = --force ] && force=1
  done

  if [ -n "$TMUX" ]; then
    printf 'Already in tmux. Use Ctrl-b s to choose a session.\n'
    return
  fi
  _tmux_herdr_check tzn "$force" || return

  cwd=${PWD%/}
  current=${cwd##*/}
  parent=${cwd%/*}
  parent=${parent##*/}

  if [ -z "$cwd" ] || [ "$cwd" = / ]; then
    name=root
  elif [ -z "$parent" ] || [ "$parent" = "$current" ]; then
    name=$current
  else
    name=${parent}-${current}
  fi

  name=$(printf '%s' "$name" | tr '.: ' '___')
  tmux new-session -A -s "$name"
)

# tmux: pick from the full session/window tree and attach independently
tza() (
  local force=0 arg

  for arg in "$@"; do
    [ "$arg" = --force ] && force=1
  done

  if [ -n "$TMUX" ]; then
    printf 'Already in tmux. Use Ctrl-b s for sessions or Ctrl-b w for windows.\n'
    return
  fi
  _tmux_herdr_check tza "$force" || return
  _tmux_tree_attach all
)

# tmux: pick a window within one session and attach independently
tzt() (
  local force=0 arg session

  for arg in "$@"; do
    case $arg in
      --force) force=1 ;;
      *) session=$arg ;;
    esac
  done

  if [ -n "$TMUX" ]; then
    printf 'Already in tmux. Use Ctrl-b w to choose a window.\n'
    return
  fi
  _tmux_herdr_check tzt "$force" || return

  session=${session:-$(tmux display-message -p '#S' 2>/dev/null)}
  if [ -z "$session" ] || ! tmux has-session -t "=$session" 2>/dev/null; then
    printf 'tmux session not found: %s\n' "${session:-<none>}" >&2
    return 1
  fi

  _tmux_tree_attach session "$session"
)

# tmux: list sessions
# 목록만 보고 세션을 만들지 않으므로 herdr 안에서도 경고 없이 동작한다.
tzl() {
  tmux list-sessions "$@" 2>/dev/null || printf 'No tmux sessions.\n'
}
