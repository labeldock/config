#!/usr/bin/env bash
# onboard — interactive setup menu. Run as `~/config/onboard`.

set -u

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
. "$SCRIPT_DIR/lib/ui.sh"
. "$SCRIPT_DIR/lib/onboard.sh"

DOTFILES_DIR="$SCRIPT_DIR/dotfiles.templates"
XDG_DIR="$SCRIPT_DIR/xdg_config.templates"
TOML_MERGE="$SCRIPT_DIR/lib/toml_merge.py"
GITCONFIG_MERGE="$SCRIPT_DIR/lib/gitconfig_merge.py"

MISE_TOOLS=(
  jq
  yq
  fd
  ripgrep
  lazygit
  delta
  yazi
  fzf
  zoxide
)

ob__extend_path

pause() {
  printf '\n%s[Enter 로 계속]%s ' "$UI_DIM" "$UI_RESET"
  read -r _ || true
}

# ---- status helpers ----

# status_copy SRC DEST → echoes: missing | same | diff
status_copy() {
  local src="$1" dest="$2"
  if [ ! -e "$dest" ]; then echo missing; return; fi
  if cmp -s "$src" "$dest"; then echo same; else echo diff; fi
}

# status_source TAG → echoes: sourced | not
status_source() {
  local tag="$1"
  local marker_source="#~/config:${tag}:source"
  local marker_begin="#~/config:${tag}:begin"
  for m in "$marker_source" "$marker_begin"; do
    if grep -Fq "$m" "$HOME/.bashrc" 2>/dev/null; then echo sourced; return; fi
    if grep -Fq "$m" "$HOME/.zshrc" 2>/dev/null; then echo sourced; return; fi
  done
  echo not
}

# status_toml_merge SRC DEST → echoes: missing | same | partial
status_toml_merge() {
  local src="$1" dest="$2"
  if [ ! -e "$dest" ]; then echo missing; return; fi
  python3 "$TOML_MERGE" status "$src" "$dest" 2>/dev/null || echo unknown
}

# status_gitconfig_merge SRC DEST → echoes: missing | same | partial
status_gitconfig_merge() {
  local src="$1" dest="$2"
  if [ ! -e "$dest" ]; then echo missing; return; fi
  python3 "$GITCONFIG_MERGE" status "$src" "$dest" 2>/dev/null || echo unknown
}

# fmt_badge STATUS → colored badge rendered to stdout
fmt_badge() {
  case "$1" in
    missing) printf '%s+ missing%s'     "$UI_CYAN"   "$UI_RESET" ;;
    same)    printf '%s= in sync%s'     "$UI_DIM"    "$UI_RESET" ;;
    diff)    printf '%s~ diff%s'        "$UI_YELLOW" "$UI_RESET" ;;
    partial) printf '%s~ partial%s'     "$UI_YELLOW" "$UI_RESET" ;;
    sourced) printf '%s= sourced%s'     "$UI_DIM"    "$UI_RESET" ;;
    not)     printf '%s+ not sourced%s' "$UI_CYAN"   "$UI_RESET" ;;
    *)       printf '%s? %s%s'          "$UI_DIM"  "$1" "$UI_RESET" ;;
  esac
}

# ---- apply helpers ----

# apply_copy SRC DEST — copy; when DEST exists and differs, show diff and prompt.
apply_copy() {
  local src="$1" dest="$2"
  if [ ! -f "$src" ]; then
    printf '%s!%s missing template: %s\n' "$UI_YELLOW" "$UI_RESET" "$src"
    return 1
  fi
  if [ ! -e "$dest" ]; then
    mkdir -p "$(dirname -- "$dest")"
    cp "$src" "$dest"
    printf '%s+%s copied (new) to %s\n' "$UI_GREEN" "$UI_RESET" "$dest"
    return 0
  fi
  if cmp -s "$src" "$dest"; then
    printf '%s=%s %s already matches template\n' "$UI_DIM" "$UI_RESET" "$dest"
    return 0
  fi
  printf '%s~%s %s differs from template:\n' "$UI_YELLOW" "$UI_RESET" "$dest"
  printf '%s(up to 200 lines; --- target / +++ template)%s\n\n' "$UI_DIM" "$UI_RESET"
  diff -u "$dest" "$src" | head -200
  printf '\nOverwrite %s? [y/N] ' "$dest"
  local yn; read -r yn
  case "$yn" in
    y|Y)
      cp "$src" "$dest"
      printf '%s✓%s overwritten\n' "$UI_GREEN" "$UI_RESET"
      ;;
    *)
      printf 'skipped\n'
      ;;
  esac
}

# apply_rc_source SRC TAG — ensure `. SRC` is sourced from ~/.bashrc and ~/.zshrc.
# Idempotent: uses a marker line tagged with TAG.
apply_rc_source() {
  local src="$1" tag="$2"
  local marker="#~/config:${tag}:source"
  local rc line
  line="[ -f \"$src\" ] && . \"$src\" ${marker}"
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] || touch "$rc"
    if grep -Fq "$marker" "$rc" 2>/dev/null; then
      printf '%s=%s %s already sources %s\n' "$UI_DIM" "$UI_RESET" "$rc" "$tag"
    else
      printf '\n%s\n' "$line" >> "$rc"
      printf '%s+%s %s now sources %s\n' "$UI_GREEN" "$UI_RESET" "$rc" "$src"
    fi
  done
}

# apply_rc_append SRC TAG — append template content into ~/.bashrc and ~/.zshrc.
# Idempotent: uses begin/end marker lines tagged with TAG.
apply_rc_append() {
  local src="$1" tag="$2"
  local marker_begin="#~/config:${tag}:begin"
  local marker_end="#~/config:${tag}:end"
  if [ ! -f "$src" ]; then
    printf '%s!%s missing template: %s\n' "$UI_YELLOW" "$UI_RESET" "$src"
    return 1
  fi
  local rc
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] || touch "$rc"
    if grep -Fq "$marker_begin" "$rc" 2>/dev/null; then
      printf '%s=%s %s already has %s block\n' "$UI_DIM" "$UI_RESET" "$rc" "$tag"
    else
      printf '\n%sAppend to %s:%s\n' "$UI_YELLOW" "$rc" "$UI_RESET"
      printf '%s' "$UI_DIM"; cat "$src"; printf '%s\n' "$UI_RESET"
      printf 'Append? [y/N] '
      local yn; read -r yn
      case "$yn" in
        y|Y)
          { printf '\n%s\n' "$marker_begin"; cat "$src"; printf '\n%s\n' "$marker_end"; } >> "$rc"
          printf '%s+%s appended to %s\n' "$UI_GREEN" "$UI_RESET" "$rc"
          ;;
        *)
          printf 'skipped\n'
          ;;
      esac
    fi
  done
}

# apply_toml_merge SRC DEST — per-[[mgr.prepend_keymap]].on block merge.
apply_toml_merge() {
  apply_key_merge "$1" "$2" "$TOML_MERGE"
}

# apply_gitconfig_merge SRC DEST — per-key gitconfig merge.
apply_gitconfig_merge() {
  apply_key_merge "$1" "$2" "$GITCONFIG_MERGE"
}

# apply_key_merge SRC DEST SCRIPT — run a python merge helper and confirm.
apply_key_merge() {
  local src="$1" dest="$2" script="$3"
  if [ ! -f "$src" ]; then
    printf '%s!%s missing template: %s\n' "$UI_YELLOW" "$UI_RESET" "$src"
    return 1
  fi
  if [ ! -e "$dest" ]; then
    mkdir -p "$(dirname -- "$dest")"
    cp "$src" "$dest"
    printf '%s+%s copied (new) to %s\n' "$UI_GREEN" "$UI_RESET" "$dest"
    return 0
  fi
  local tmp; tmp=$(mktemp)
  if ! python3 "$script" merge "$src" "$dest" > "$tmp"; then
    rm -f "$tmp"
    printf '%s!%s merge failed (python3 required)\n' "$UI_YELLOW" "$UI_RESET"
    return 1
  fi
  if cmp -s "$dest" "$tmp"; then
    printf '%s=%s %s already has all template keys\n' "$UI_DIM" "$UI_RESET" "$dest"
    rm -f "$tmp"
    return 0
  fi
  printf '%s~%s %s would be merged:\n' "$UI_YELLOW" "$UI_RESET" "$dest"
  printf '%s(up to 200 lines; --- target / +++ merged)%s\n\n' "$UI_DIM" "$UI_RESET"
  diff -u "$dest" "$tmp" | head -200
  printf '\nApply merge? [y/N] '
  local yn; read -r yn
  case "$yn" in
    y|Y)
      mv "$tmp" "$dest"
      printf '%s✓%s merged\n' "$UI_GREEN" "$UI_RESET"
      ;;
    *)
      rm -f "$tmp"
      printf 'skipped\n'
      ;;
  esac
}

pick_mise_tools() {
  local -a labels=()
  local -a presel=()
  local i tool
  for ((i=0; i<${#MISE_TOOLS[@]}; i++)); do
    tool="${MISE_TOOLS[$i]}"
    if ob_tool_installed "$tool"; then
      labels[$i]="$tool ${UI_DIM}(installed)${UI_RESET}"
    else
      labels[$i]="$tool"
      presel+=($i)
    fi
  done
  ui_multiselect "mise 글로벌 설치 대상" labels "${presel[*]:-}"
  if [ -z "$UI_CHOICES" ]; then
    printf '취소됨\n'
    return 0
  fi
  local -a picked=()
  for i in $UI_CHOICES; do
    picked+=("${MISE_TOOLS[$i]}")
  done
  if [ ${#picked[@]} -eq 0 ]; then
    printf '선택 없음\n'
    return 0
  fi
  echo
  ob_install_mise_tools "${picked[@]}"
}

# ---- install actions ----

do_recommend() {
  printf '\n%s== Recommend ==%s\n' "$UI_BOLD" "$UI_RESET"
  ob_install_brew
  echo
  ob_install_mise
  echo
  pick_mise_tools
}

do_brew() {
  printf '\n%s== Brew ==%s\n' "$UI_BOLD" "$UI_RESET"
  ob_install_brew
}

do_mise() {
  printf '\n%s== Mise ==%s\n' "$UI_BOLD" "$UI_RESET"
  ob_install_mise
  echo
  pick_mise_tools
}

# ---- config actions ----

do_gitconfig() {
  printf '\n%s== gitconfig ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_gitconfig_merge "$DOTFILES_DIR/.gitconfig" "$HOME/.gitconfig"
}

do_nanorc() {
  printf '\n%s== nanorc ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_copy "$DOTFILES_DIR/.nanorc" "$HOME/.nanorc"
}

do_tmux() {
  printf '\n%s== tmux.conf ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_copy "$DOTFILES_DIR/.tmux.conf" "$HOME/.tmux.conf"
  tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
}

do_ghostty() {
  printf '\n%s== ghostty ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_copy "$XDG_DIR/ghostty/config" "$HOME/.config/ghostty/config"
}

do_tm_properties() {
  printf '\n%s== tm_properties ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_copy "$DOTFILES_DIR/.tm_properties" "$HOME/.tm_properties"
}

do_yazi() {
  printf '\n%s== yazi ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_toml_merge "$XDG_DIR/yazi/keymap.toml" "$HOME/.config/yazi/keymap.toml"
}

# ---- ai-config actions ----

do_opencode() {
  printf '\n%s== opencode ==%s\n' "$UI_BOLD" "$UI_RESET"
  local f
  for f in "$XDG_DIR"/opencode/opencode-*.json; do
    [ -f "$f" ] || continue
    apply_copy "$f" "$HOME/.config/opencode/$(basename "$f")"
  done
  apply_rc_source "$XDG_DIR/opencode/.bashrc.template" "opencode"
}

do_claude() {
  printf '\n%s== claude ==%s\n' "$UI_BOLD" "$UI_RESET"
  apply_rc_append "$DOTFILES_DIR/.claude/.bashrc.template" "claude"
}

# ---- submenus ----

submenu_install() {
  local -a labels actions
  while true; do
    printf '\033[H\033[2J'
    local brew_tag="" mise_tag=""
    ob_has brew && brew_tag=" ${UI_GREEN}(installed)${UI_RESET}"
    ob_has mise && mise_tag=" ${UI_GREEN}(installed)${UI_RESET}"
    labels=(
      "Recommend — brew + mise + global tools"
      "Brew 설치${brew_tag}"
      "Mise 설치${mise_tag}"
      "← back"
    )
    actions=(
      do_recommend
      do_brew
      do_mise
      __back
    )
    ui_menu "install" labels
    [ "$UI_CHOICE" = "255" ] && return 0
    local fn="${actions[$UI_CHOICE]}"
    [ "$fn" = "__back" ] && return 0
    "$fn"
    pause
  done
}

submenu_config() {
  local -a labels actions
  while true; do
    printf '\033[H\033[2J'
    local st_git st_nano st_tmux st_ghostty st_tm st_yazi
    st_git=$(status_gitconfig_merge "$DOTFILES_DIR/.gitconfig" "$HOME/.gitconfig")
    st_nano=$(status_copy      "$DOTFILES_DIR/.nanorc"        "$HOME/.nanorc")
    st_tmux=$(status_copy      "$DOTFILES_DIR/.tmux.conf"     "$HOME/.tmux.conf")
    st_ghostty=$(status_copy   "$XDG_DIR/ghostty/config"      "$HOME/.config/ghostty/config")
    st_tm=$(status_copy        "$DOTFILES_DIR/.tm_properties" "$HOME/.tm_properties")
    st_yazi=$(status_toml_merge "$XDG_DIR/yazi/keymap.toml"   "$HOME/.config/yazi/keymap.toml")
    labels=(
      "gitconfig      $(fmt_badge "$st_git")"
      "nanorc         $(fmt_badge "$st_nano")"
      "tmux           $(fmt_badge "$st_tmux")"
      "ghostty        $(fmt_badge "$st_ghostty")"
      "tm_properties  $(fmt_badge "$st_tm")"
      "yazi           $(fmt_badge "$st_yazi")"
      "← back"
    )
    actions=(
      do_gitconfig
      do_nanorc
      do_tmux
      do_ghostty
      do_tm_properties
      do_yazi
      __back
    )
    ui_menu "config" labels
    [ "$UI_CHOICE" = "255" ] && return 0
    local fn="${actions[$UI_CHOICE]}"
    [ "$fn" = "__back" ] && return 0
    "$fn"
    pause
  done
}

submenu_ai_config() {
  local -a labels actions
  while true; do
    printf '\033[H\033[2J'
    local st_opencode st_claude
    st_opencode=$(status_source "opencode")
    st_claude=$(status_source   "claude")
    labels=(
      "opencode  $(fmt_badge "$st_opencode")"
      "claude    $(fmt_badge "$st_claude")"
      "← back"
    )
    actions=(
      do_opencode
      do_claude
      __back
    )
    ui_menu "ai-config" labels
    [ "$UI_CHOICE" = "255" ] && return 0
    local fn="${actions[$UI_CHOICE]}"
    [ "$fn" = "__back" ] && return 0
    "$fn"
    pause
  done
}

do_exit() {
  printf '\nbye.\n'
  exit 0
}

main() {
  local -a labels actions
  labels=(
    "install"
    "config"
    "ai-config"
    "Exit"
  )
  actions=(
    submenu_install
    submenu_config
    submenu_ai_config
    do_exit
  )
  while true; do
    printf '\033[H\033[2J'
    ui_menu "onboard" labels
    if [ "$UI_CHOICE" = "255" ]; then
      do_exit
    fi
    local fn="${actions[$UI_CHOICE]}"
    "$fn"
  done
}

main "$@"
